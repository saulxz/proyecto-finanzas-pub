# -----------------------------------------------------------------------------
# Variables de entorno
# Copia este archivo como `.env.local` y sustituye los valores de ejemplo:
#   cp .env.example .env.local
# El archivo `.env.local` está ignorado por git: no lo subas nunca.
# -----------------------------------------------------------------------------

# URL del proyecto Supabase.
# Panel de Supabase > Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública (anon / publishable) del proyecto Supabase.
# Panel de Supabase > Settings > API Keys > anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICA_SUPABASE

# API key de OpenRouter, usada por el asistente de IA, el categorizador
# automático y el OCR de tickets.
# Panel de OpenRouter > https://openrouter.ai/keys
OPENROUTER_API_KEY=TU_API_KEY_DE_OPENROUTER